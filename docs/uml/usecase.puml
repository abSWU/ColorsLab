@startuml
left to right direction
skinparam shadowing false
actor "Visitor" as Visitor
actor "Logged-in User" as User
rectangle "COLORS Web Application" {
  usecase "Log in" as Login
  usecase "Add color" as Add
  usecase "Search own colors" as Search
  usecase "Log out" as Logout
}
Visitor --> Login
User --> Add
User --> Search
User --> Logout
note bottom of Login
  Login.php validates credentials
  against the Users table.
end note
note bottom of Search
  SearchColors.php filters by
  both color name and userId.
end note
@enduml
